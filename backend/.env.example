# Copy to backend/.env and fill in. Never commit .env.

# Server
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Storage (SQLite). Audio is never stored.
DB_PATH=data/scamshield.db
# Store transcript text inside persisted events. false = text fields are redacted before writing.
STORE_TRANSCRIPTS=true

# Sessions
SESSION_IDLE_TIMEOUT_S=600
EVENT_QUEUE_SIZE=256
EVENT_REPLAY_SIZE=200

# Speech-to-text (faster-whisper on CPU). Benchmark with `make bench-stt`.
STT_MODEL=small
STT_DETECT_MODEL=tiny
STT_COMPUTE_TYPE=int8
STT_CPU_THREADS=4
STT_BEAM_SIZE=1
STT_TIMEOUT_S=8
STT_LOAD_ON_STARTUP=true

# Voice activity detection (webrtcvad, 0-3)
VAD_AGGRESSIVENESS=2
VAD_END_SILENCE_MS=600
VAD_SOFT_MAX_MS=8000
VAD_SOFT_PAUSE_MS=60
VAD_MAX_UTTERANCE_MS=12000

# Trained coercion-tactic classifier (models/coercion/, built by `make train-coercion`).
# Missing model files -> /health shows classifier "unavailable" and the lexicon runs alone.
COERCION_MODEL_ENABLED=true
COERCION_MODEL_DIR=models/coercion
COERCION_MODEL_THREADS=1
COERCION_MODEL_TIMEOUT_S=1.0

# Alerts (dashboard channel; SMS/WhatsApp in B9). Fills "Call <name> now".
ELDER_NAME=
ALERT_SEND_TIMEOUT_S=5

# Verification via TinyFish Search + Fetch (key from agent.tinyfish.ai/api-keys). Empty = unconfigured.
TINYFISH_API_KEY=
TINYFISH_TIMEOUT_S=8
TINYFISH_SEARCH_PER_MINUTE=30
TINYFISH_FETCH_PER_MINUTE=150
VERIFY_CACHE_TTL_S=86400

# LLM coercion tagger (later milestone)
LLM_ENABLED=false

